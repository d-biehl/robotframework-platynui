# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# VSCode
.vscode/**
!.vscode/extensions.json

# macOS
.DS_Store

# robot
results/
.robot.toml

# gradle (Java test fixtures; their build/ output is covered by build/ above)
.gradle/

# rust
target/

# Added by cargo

/target

# trash
trash/
.trash/

# temp files
*.tmp
*.log
*.bak
*.swp
*~

# playground
playground/

# Native Python extension artifacts (ensure not tracked at root)
packages/**/*.so
packages/**/*.pyd
packages/**/*.dylib

# The agent JAR is staged into its delivery package by `just build-provider-java`.
# Never committed: it must always match the sources it was built from, and a stale
# copy is the one drift the exact-version handshake cannot catch.
packages/provider-java/src/platynui_provider_java/agent/*.jar
packages/**/*.pdb
packages/**/*.dSYM/

# cibuildwheel artifacts
wheelhouse/

.agents
skills-lock.json

# Claude Code per-developer local settings (permissions etc.); shared settings
# live in the tracked .claude/settings.json.
.claude/settings.local.json
